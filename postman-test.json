{
  "info": {
    "_postman_id": "e9f8d7c6-b5a4-3210-9876-54321fedcba0",
    "name": "Eventprac - Automated Scenario Test",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Step 1: Register User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Scenario Tester\",\n  \"email\": \"test_{{$randomInt}}@example.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/user/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "user",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Step 2: Get Events (Before Create)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "events"
          ]
        }
      },
      "response": []
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.event && jsonData.event.ID) {",
              "    pm.collectionVariables.set('createdEventId', jsonData.event.ID);",
              "    console.log('Created Event ID:', jsonData.event.ID);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "name": "Step 3: Create Event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Automated Test Event\",\n  \"description\": \"Created during scenario test\",\n  \"location\": \"Jakarta\",\n  \"datetime\": \"2026-09-08T15:54:55+07:00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "events"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Step 4: Get Events (After Create)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "events"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Step 5: Delete Created Event",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/events/:id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "events",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "{{createdEventId}}",
              "description": "Diisi otomatis dari Step 3"
            }
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "createdEventId",
      "value": "",
      "type": "string"
    }
  ]
}