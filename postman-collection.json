    {
      "name": "Server",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health responded', function () {",
                  "    pm.expect([200, 503]).to.include(pm.response.code);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.test('Server status reported', function () {",
                  "    pm.expect(response.services.server.status).to.eql('up');",
                  "});",
                  "pm.test('Database ping reported', function () {",
                  "    pm.expect(response.services.database).to.have.property('status');",
                  "});",
                  "pm.test('ImageKit ping reported', function () {",
                  "    pm.expect(response.services.imagekit).to.have.property('status');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
