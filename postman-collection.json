                "api",
                "user",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.test('JWT token returned', function () {",
                  "    pm.expect(response.token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (response.token) {",
                  "    pm.globals.set('jwtToken', response.token);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
