                "exec": [
                  "pm.test('Event created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "const eventId = response.event && (response.event.ID || response.event.id);",
                  "pm.test('Event ID returned', function () {",
                  "    pm.expect(eventId).to.exist;",
                  "});",
                  "",
                  "if (eventId) {",
